# ---------------------------------------------------------------------------
# Pflicht
# ---------------------------------------------------------------------------

# PostgreSQL. Ohne diese Variable startet die Anwendung nicht.
# Beispiel: postgresql://benutzer:passwort@host:5432/carswap?sslmode=require
DATABASE_URL=

# ---------------------------------------------------------------------------
# Für den vollen Funktionsumfang
# ---------------------------------------------------------------------------

# Stripe: Treuhand-Einzahlung und Auszahlung über Connect.
# Ohne diese Schlüssel funktionieren nur Tausche ohne Wertdifferenz.
STRIPE_SECRET_KEY=
# Signaturgeheimnis des Webhook-Endpunkts /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Vercel Blob für Fahrzeugfotos. Ohne Token zeigt die Anwendung eine
# schematische Darstellung statt Fotos.
BLOB_READ_WRITE_TOKEN=

# Resend für E-Mails (Bestätigung, Passwort-Reset, Benachrichtigungen).
# Ohne Schlüssel werden Nachrichten nur ins Server-Log geschrieben.
RESEND_API_KEY=
MAIL_FROM="CarSwap <noreply@deine-domain.ch>"

# Basis-URL für Links in E-Mails und Stripe-Weiterleitungen.
# Wird nur serverseitig gelesen, braucht also kein NEXT_PUBLIC_-Präfix.
# Auf Vercel wird ersatzweise VERCEL_PROJECT_PRODUCTION_URL verwendet.
SITE_URL=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Passwort der Demo-Konten aus npm run db:seed
SEED_PASSWORD=
