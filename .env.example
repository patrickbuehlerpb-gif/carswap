# ---------------------------------------------------------------------------
# Pflicht
# ---------------------------------------------------------------------------

# PostgreSQL. Ohne diese Variable startet die Anwendung nicht.
# Beispiel: postgresql://benutzer:passwort@host:5432/carswap?sslmode=require
DATABASE_URL=

# ---------------------------------------------------------------------------
# Für den vollen Funktionsumfang
# ---------------------------------------------------------------------------

# Stripe: Treuhand-Einzahlung und Auszahlung über Connect.
# Ohne diese Schlüssel funktionieren nur Tausche ohne Wertdifferenz.
STRIPE_SECRET_KEY=
# Signaturgeheimnis des Webhook-Endpunkts /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Vercel Blob für Fahrzeugfotos. Ohne Token zeigt die Anwendung eine
# schematische Darstellung statt Fotos.
BLOB_READ_WRITE_TOKEN=

# Resend für E-Mails (Bestätigung, Passwort-Reset, Benachrichtigungen).
# Ohne Schlüssel werden Nachrichten nur ins Server-Log geschrieben.
RESEND_API_KEY=
MAIL_FROM="autotauschen <noreply@autotauschen.app>"

# Basis-URL für Links in E-Mails und Stripe-Weiterleitungen.
# Wird nur serverseitig gelesen, braucht also kein NEXT_PUBLIC_-Präfix.
# Auf Vercel wird ersatzweise VERCEL_PROJECT_PRODUCTION_URL verwendet.
# Produktion: https://autotauschen.app (mit Schema, ohne Schrägstrich am Ende).
SITE_URL=

# ---------------------------------------------------------------------------
# Rechtsseiten
#
# Impressum, AGB und Datenschutzerklärung ziehen ihre Angaben von hier. Fehlt
# eine, benennt die betroffene Seite die Lücke sichtbar — eine unvollständige
# Rechtsseite als vollständig auszugeben wäre schlimmer.
# ---------------------------------------------------------------------------

OPERATOR_NAME=
# AG, GmbH, Einzelunternehmen …
OPERATOR_LEGAL_FORM=
OPERATOR_ADDRESS=
OPERATOR_UID=
# Kontaktadresse. Bekommt auch die Meldungen zu Inseraten und den Lagebericht.
OPERATOR_EMAIL=
# Ergänzend, werden weggelassen, wenn sie fehlen.
OPERATOR_REGISTER=
OPERATOR_PHONE=

# Wer die Datenbank betreibt — so, wie es in der Datenschutzerklärung stehen
# soll. Vercel, Stripe und Resend stehen fest im Code; hinter DATABASE_URL kann
# jeder stecken, und geraten wird in einem Rechtstext nicht.
# Beispiel: OPERATOR_DB_PROVIDER="Neon Inc. (USA), Server in Frankfurt"
OPERATOR_DB_PROVIDER=

# ---------------------------------------------------------------------------
# Betrieb
# ---------------------------------------------------------------------------

# Details unter /api/health, nur als «Authorization: Bearer …».
HEALTH_TOKEN=
# Vercel schickt es den täglichen Läufen unter /api/cron/* mit. Ohne das
# Geheimnis antworten sie in Produktion nur mit 401.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Passwort der Demo-Konten aus npm run db:seed
SEED_PASSWORD=
